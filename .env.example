# OpenAI API key, used for both embeddings and generation
OPENAI_API_KEY=sk-...

# Optional model overrides
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Optional retrieval tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Optional hybrid fusion weights (weighted RRF). Leave both at 1 for plain RRF.
# Raise the lexical weight on corpora full of exact identifiers (codes, SKUs),
# raise the dense weight on prose-heavy, paraphrase-rich corpora.
HYBRID_DENSE_WEIGHT=1
HYBRID_LEXICAL_WEIGHT=1
